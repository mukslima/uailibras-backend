{
  "name": "uailibras-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs \"src/**/*.test.ts\"",
    "test:auth": "node scripts/run-tests.cjs src/auth.test.ts",
    "test:cors": "node scripts/run-tests.cjs src/cors.test.ts",
    "test:news": "node scripts/run-tests.cjs src/news.test.ts",
    "test:featured": "node scripts/run-tests.cjs src/news-featured.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node --require ./scripts/tsx-windows-fix.cjs --import tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cloudinary": "^2.10.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
