# Copy this file to .env and adjust values for your local environment.
# Do not use production credentials here.

NODE_ENV="development"
PORT="3333"
HOST="0.0.0.0"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/uailibras"
# Required for npm test. Use a dedicated test database, not a different schema in the dev database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/uailibras_test"

JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional refresh cookie settings for production.
# Keep REFRESH_TOKEN_COOKIE_DOMAIN empty unless the admin and API require a shared parent domain.
REFRESH_TOKEN_COOKIE_DOMAIN=""
REFRESH_TOKEN_COOKIE_SAMESITE="lax"

# Comma-separated frontend/admin origins allowed to call the API with credentials.
# Production: set the HTTPS provider URLs for the public site and admin app.
# Example: CORS_ORIGINS="https://uailibras-site.vercel.app,https://uailibras-admin.vercel.app"
CORS_ORIGINS="http://localhost:3000"
# Backward-compatible alias still supported by the backend.
ADMIN_CORS_ORIGINS="http://localhost:3000"

SEED_ADMIN_USERNAME=""
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
