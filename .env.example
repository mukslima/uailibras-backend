# Copy this file to .env and adjust values for your local environment.
# Do not use production credentials here.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE?schema=public"

JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated admin frontend origins allowed to call the API with cookies.
# Example for production: ADMIN_CORS_ORIGINS="https://painel.uailibras.com.br"
ADMIN_CORS_ORIGINS="http://localhost:3000"

SEED_ADMIN_USERNAME=""
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
